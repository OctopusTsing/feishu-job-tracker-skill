{
  "template_version": 2,
  "base_name": "求职进度跟踪",
  "table_name": "投递记录",
  "timezone": "Asia/Shanghai",
  "default_followup_days": 7,
  "fields": [
    { "key": "company", "name": "公司", "type": "text", "required": true },
    { "key": "role", "name": "岗位名称", "type": "text", "required": true },
    { "key": "status", "name": "投递状态", "type": "single_select", "required": true, "options": ["待评估", "准备投递", "已投递", "测评/笔试", "AI 面试", "一面", "二面", "HR 面", "OC", "Offer", "拒绝", "无响应", "放弃"] },
    { "key": "job_url", "name": "岗位链接", "type": "url" },
    { "key": "source", "name": "平台来源", "type": "single_select", "options": ["Boss 直聘", "牛客", "实习僧", "猎聘", "智联招聘", "前程无忧", "公司官网", "内推", "公众号", "其他"] },
    { "key": "job_type", "name": "岗位类型", "type": "single_select", "options": ["日常实习", "暑期实习", "校招", "社招", "项目制", "其他"] },
    { "key": "track", "name": "方向", "type": "single_select", "options": ["技术", "产品", "运营", "数据", "设计", "市场", "销售", "职能", "研究", "其他"] },
    { "key": "city", "name": "城市", "type": "text" },
    { "key": "priority", "name": "优先级", "type": "single_select", "options": ["高", "中", "低"] },
    { "key": "fit_score", "name": "匹配度", "type": "number" },
    { "key": "applied_date", "name": "投递日期", "type": "date" },
    { "key": "updated_at", "name": "最近更新时间", "type": "date", "required": true },
    { "key": "next_action", "name": "下一步动作", "type": "text" },
    { "key": "next_date", "name": "下一步日期", "type": "date" },
    { "key": "work_mode", "name": "工作模式", "type": "single_select", "options": ["现场", "混合", "远程", "驻场", "不确定"] },
    { "key": "resume_version", "name": "简历版本", "type": "text" },
    { "key": "contact", "name": "联系人/HR", "type": "text" },
    { "key": "jd_summary", "name": "JD 摘要", "type": "text" },
    { "key": "jd_text", "name": "JD 原文", "type": "long_text" },
    { "key": "risk_signals", "name": "风险信号", "type": "multi_select", "options": ["外包/驻场", "职责过杂", "无转正信息", "实习时长过长", "JD 模糊", "硬门槛不满足", "薪资不明", "其他"] },
    { "key": "ai_notes", "name": "AI 备注", "type": "long_text" },
    { "key": "result_reason", "name": "结果原因", "type": "single_select", "options": ["无反馈", "不匹配", "HC 关闭", "笔试未过", "面试未过", "薪资不合适", "个人放弃", "其他"] },
    { "key": "user_notes", "name": "备注", "type": "long_text" }
  ],
  "views": [
    { "name": "全部投递", "type": "grid" },
    { "name": "本周待办", "type": "grid", "hint": "下一步日期在本周，且状态不是 Offer/拒绝/放弃" },
    { "name": "高优先级", "type": "grid", "hint": "优先级 = 高" },
    { "name": "面试中", "type": "grid", "hint": "状态包含 AI 面试/一面/二面/HR 面" },
    { "name": "已投递待反馈", "type": "grid", "hint": "状态 = 已投递/测评/笔试，按最近更新时间排序" },
    { "name": "已结束", "type": "grid", "hint": "状态 = Offer/拒绝/放弃" },
    { "name": "按公司分组", "type": "grid", "hint": "按公司分组，避免同公司重复投递" }
  ]
}
